# Copy thành .env.prod trên server rồi điền giá trị thật — KHÔNG commit .env.prod thật lên git.
BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-v1-changeme
LOG_LEVEL=INFO

# MCP (backend Java Spring AI) — MCP_API_KEY phải khớp APP_MCP_API_KEY của backend.
MCP_SERVER_URL=http://localhost:8080/mcp
MCP_API_KEY=changeme

# Backend Spring dùng để xác thực người dùng — chatbot forward Bearer token của user
# sang GET {BACKEND_BASE_URL}/api/v1/xac-thuc/toi (xem app/security/middleware.py).
BACKEND_BASE_URL=http://localhost:8080
